{
  "name": "@ranjithrajv/opencode-model-recommender",
  "version": "0.1.0",
  "description": "Recommends the best models on OpenCode Zen and OpenCode Go by cache ratio, token cost, and session cost.",
  "keywords": [
    "cache",
    "cost",
    "models",
    "opencode",
    "opencode-plugin",
    "recommendation"
  ],
  "license": "AGPL-3.0",
  "author": "Ranjith Raj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjithrajv/opencode-model-recommender.git"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "metrics.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "check": "vp check",
    "check:fix": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled"
  },
  "dependencies": {
    "@opencode-ai/plugin": "beta",
    "opencode-plugin-kit": "^1.0.0-alpha.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "^0.1.16",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "^1.9.15"
  },
  "packageManager": "bun@1.4.2"
}
